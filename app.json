{
  "expo": {
    "name": "Relun",
    "slug": "relun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.relun.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF5E62"
      },
      "package": "com.relun.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "enabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Relun to use your location to find matches nearby."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Relun to access your camera for profile verification."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF6B9D"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5E62"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27ec6cce-aa9c-4d4c-b24b-fc83d0badecf"
      }
    }
  }
}
